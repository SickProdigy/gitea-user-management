# URL reachable from this container. If it joins the same Docker network as Gitea,
# use the Gitea service/container name and internal port.
GITEA_BASE_URL=http://gitea:3000

# Create this in Gitea as an admin user token. Required scopes depend on Gitea
# version, but admin/user write access is needed.
GITEA_TOKEN=replace_me_gitea_admin_token

# Password/token used to log into this management panel.
PANEL_AUTH_TOKEN=replace_me_long_random_panel_password

# Random secret for signed browser sessions. Generate a long random value.
PANEL_SECRET_KEY=replace_me_random_session_secret
